PORT=5000
NODE_ENV=production

# MongoDB (Atlas URI, or mongodb://mongo:27017/khetimaster with the local-db compose profile)
MONGO_URI=

# Auth
ACCESS_TOKEN_SECRET=
ACCESS_TOKEN_EXPIRES_IN=15m
OTP_EXPIRY_MINUTES=5

# Email (nodemailer)
EMAIL_USER=
EMAIL_PASSWORD=

# Articles
ARTICLE_REFRESH_MINUTES=30
ARTICLE_REFRESH_SECRET=
ARTICLE_CACHE_DAYS=4
ARTICLE_CACHE_LIMIT=100
PIB_RSS_URL=
ICAR_NEWS_URL=
FAO_NEWS_URL=

# Mandi rates (data.gov.in). Register at data.gov.in for a key; the public
# sample key only returns 10 rows per request.
DATA_GOV_MANDI_API_KEY=
# How long mandi prices are cached in memory (minutes)
MANDI_CACHE_MINUTES=30
# Rows requested per data.gov.in call (the key may allow fewer)
MANDI_PAGE_SIZE=1000

# Smart farm advisory
# CropGen satellite API (availability, indices, NPK, crop-health score)
SATELLITE_API_KEY=
CROPGEN_TS_BASE=https://server.cropgenapp.com/v4/api
# OpenAI key: powers AI Guru chat and AI-written advisory activity text
# (advisory falls back to rule-based text without it; AI Guru needs it)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI Guru assistant (all optional)
# AI_GURU_MODEL overrides OPENAI_MODEL for chat only
AI_GURU_MODEL=
AI_GURU_TEMPERATURE=0.42
AI_GURU_MAX_TOKENS=1024
AI_GURU_TIMEOUT_MS=60000
# Questions one user may ask per day (India time)
AI_GURU_DAILY_MESSAGE_LIMIT=100
# Regenerate on open when the latest advisory is older than this
ADVISORY_STALE_HOURS=24
# Daily job: force a new advisory after this many days
ADVISORY_MAX_AGE_DAYS=3
ADVISORY_REFRESH_CRON=30 5 * * *
